/* qgroundcontrol.qss */

QMainWindow, QWidget {
    background-color: #2e3436;
    color: #f5f5f5;
    font-family: "Segoe UI", "Helvetica Neue", "Arial", sans-serif;
    font-size: 14px;
}

QPushButton {
    background-color: #3b4245;
    border: 1px solid #454d52;
    color: #f5f5f5;
    padding: 8px 16px;
    border-radius: 4px;
}
QPushButton:hover {
    background-color: #454d52;
}
QPushButton:pressed {
    background-color: #2c313a;
    border: 1px solid #1a1a1a;
}

QPushButton#connect_button {
    background-color: #007bff;
    border: none;
}
QPushButton#connect_button:hover {
    background-color: #0056b3;
}

QLineEdit {
    background-color: #3b4245;
    border: 1px solid #454d52;
    color: #f5f5f5;
    padding: 6px;
    border-radius: 4px;
}
QLineEdit:focus {
    border: 1px solid #007bff;
}

QLabel {
    color: #f5f5f5;
}

QListWidget {
    background-color: #2c313a;
    border: 1px solid #454d52;
    color: #f5f5f5;
    padding: 5px;
    border-radius: 4px;
    outline: none;
}
QListWidget::item {
    padding: 5px;
}
QListWidget::item:selected {
    background-color: #007bff;
    color: white;
}

QListWidget#log_list_widget {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
}

QScrollBar:vertical {
    background: #2e3436;
    border: none;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #555;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}